{
  "name": "uber-multi-region-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:gateway": "ts-node-dev --respawn --transpile-only src/api-gateway/index.ts",
    "dev:region:a": "cross-env REGION=A ts-node-dev --respawn --transpile-only src/region/index.ts",
    "dev:region:b": "cross-env REGION=B ts-node-dev --respawn --transpile-only src/region/index.ts",
    "dev": "concurrently \"npm:dev:gateway\" \"npm:dev:region:a\" \"npm:dev:region:b\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/morgan": "^1.9.9",
    "cross-env": "^7.0.3",
    "concurrently": "^9.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}


